<?xml version="1.0"?>

<?xml-model
  href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>

<package format="3">

  <name>cleaning_robot_perception</name>

  <version>0.0.0</version>

  <description>
    Perception package for the Surgical Cleaning Robot.
    Includes ZED camera acquisition, object detection,
    ChArUco tracking, plane detection, and spill detection.
  </description>

  <maintainer email="daniel.agbara17@gmail.com">
    agbara-admin
  </maintainer>

  <license>Apache-2.0</license>


  <!-- ========================= -->
  <!-- ROS Dependencies          -->
  <!-- ========================= -->

  <depend>rclpy</depend>

  <depend>sensor_msgs</depend>

  <depend>geometry_msgs</depend>

  <depend>std_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>message_filters</depend>


  <!-- ========================= -->
  <!-- Launch Dependencies       -->
  <!-- ========================= -->

  <exec_depend>launch</exec_depend>

  <exec_depend>launch_ros</exec_depend>


  <!-- ========================= -->
  <!-- Testing                   -->
  <!-- ========================= -->

  <test_depend>ament_copyright</test_depend>

  <test_depend>ament_flake8</test_depend>

  <test_depend>ament_pep257</test_depend>

  <test_depend>python3-pytest</test_depend>


  <!-- ========================= -->
  <!-- Package Type              -->
  <!-- ========================= -->

  <export>

    <build_type>ament_python</build_type>

  </export>

</package>